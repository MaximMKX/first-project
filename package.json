{
  "name": "flight-calendar",
  "version": "1.0.0",
  "description": "航班排班日历应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.flight-calendar.app",
    "productName": "航班排班日历",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "data/",
      "!node_modules/**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "renderer/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "renderer/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "tesseract.js": "^7.0.0"
  }
}
